@model AcxiomCRM.Web.Models.LeadConversionViewModel
@{
    ViewData["Title"] = "Convert Lead to Customer";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card border-0 shadow-lg rounded-4">
            <div class="card-header bg-success text-white border-0 pt-4 px-4">
                <h3 class="fw-bold mb-0"><i class="bi bi-arrow-repeat me-2"></i>Lead Conversion Workflow</h3>
                <p class="mb-0 text-white-50">Convert prospective lead into active Customer & Opportunity</p>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-light border mb-4">
                    <h5 class="fw-bold text-dark mb-1">Lead: @Model.LeadName</h5>
                    <p class="mb-0 text-muted">Company: <strong>@(string.IsNullOrEmpty(Model.CompanyName) ? "N/A" : Model.CompanyName)</strong> | Expected Value: <strong>₹@Model.ExpectedValue.ToString("N0")</strong></p>
                </div>

                <form asp-action="Convert" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LeadId" />
                    <input type="hidden" asp-for="LeadName" />
                    <input type="hidden" asp-for="CompanyName" />
                    <input type="hidden" asp-for="ExpectedValue" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small" role="alert"></div>

                    <div class="form-check form-switch mb-3">
                        <input asp-for="CreateOpportunity" class="form-check-input" type="checkbox" role="switch" id="toggleOpp" checked />
                        <label class="form-check-label fw-bold" for="toggleOpp">Also create a new Sales Opportunity for this customer</label>
                    </div>

                    <div id="oppSection" class="card card-body bg-light border-0 mb-3">
                        <h6 class="fw-bold text-primary mb-3">Opportunity Details</h6>
                        <div class="mb-3">
                            <label asp-for="OpportunityName" class="form-label fw-bold"></label>
                            <input asp-for="OpportunityName" class="form-control" />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Amount" class="form-label fw-bold">Deal Amount (₹)</label>
                                <input asp-for="Amount" class="form-control" type="number" step="0.01" />
                                <span asp-validation-for="Amount" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ExpectedCloseDate" class="form-label fw-bold">Expected Close Date</label>
                                <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
                                <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 text-end">
                        <a asp-action="Index" class="btn btn-outline-secondary me-2">Cancel</a>
                        <button type="submit" class="btn btn-success px-4 fw-bold">Complete Conversion</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
