@model AcxiomCRM.Services.Interfaces.UserDto
@{
    ViewData["Title"] = "Edit User";
    var rolesList = ViewBag.RolesList as List<AcxiomCRM.Domain.Entities.ApplicationRole> ?? new List<AcxiomCRM.Domain.Entities.ApplicationRole>();
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h3 class="fw-bold mb-0"><i class="bi bi-pencil-square text-primary me-2"></i>Edit User Profile</h3>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Full Name</label>
                        <input type="text" name="fullName" value="@Model.FullName" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Email Address</label>
                        <input type="email" name="email" value="@Model.Email" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Assigned Primary Role</label>
                        <select name="role" class="form-select" required>
                            @foreach (var r in rolesList)
                            {
                                <option value="@r.Name" selected="@(Model.Role == r.Name)">@r.Name</option>
                            }
                        </select>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input type="checkbox" name="isActive" value="true" class="form-check-input" id="activeCheck" checked="@Model.IsActive" />
                        <label class="form-check-label fw-bold" for="activeCheck">Account Active</label>
                    </div>

                    <div class="text-end">
                        <a asp-action="Index" class="btn btn-outline-secondary me-2">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">Update User</button>
                    </div>
                </form>

                <hr class="my-4" />

                <div class="bg-light p-3 rounded-3">
                    <h6 class="fw-bold text-danger mb-2"><i class="bi bi-key-fill me-1"></i> Admin Password Reset</h6>
                    <form asp-action="ResetPassword" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-center">
                        @Html.AntiForgeryToken()
                        <div class="col-8">
                            <input type="password" name="newPassword" class="form-control form-control-sm" placeholder="New Password (min 8 chars)" required />
                        </div>
                        <div class="col-4">
                            <button type="submit" class="btn btn-sm btn-danger w-100 fw-bold">Reset Password</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
