@model IEnumerable<AcxiomCRM.Domain.Entities.FollowUp>
@{
    ViewData["Title"] = "Follow-Up Management";
    var usersList = ViewBag.UsersList as List<AcxiomCRM.Services.Interfaces.UserDto> ?? new List<AcxiomCRM.Services.Interfaces.UserDto>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-calendar-event text-primary me-2"></i>Follow-Up Management</h2>
        <p class="text-muted mb-0">Schedule, complete and track customer & lead follow-up activities</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Schedule Follow-Up
    </a>
</div>

<!-- Quick Stats Badges -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 bg-primary text-white p-3 rounded-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-white-50 small fw-bold">UPCOMING PLANNED FOLLOW-UPS</span>
                    <h3 class="fw-bold mb-0">@ViewBag.UpcomingCount</h3>
                </div>
                <i class="bi bi-calendar-check fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 bg-danger text-white p-3 rounded-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-white-50 small fw-bold">OVERDUE FOLLOW-UPS</span>
                    <h3 class="fw-bold mb-0">@ViewBag.OverdueCount</h3>
                </div>
                <i class="bi bi-exclamation-triangle fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
</div>

<!-- Search & Filter Bar -->
<div class="card card-body bg-light border-0 mb-4 shadow-sm">
    <form method="get" asp-action="Index" class="row g-3">
        <div class="col-md-3">
            <input type="date" name="searchDate" value="@ViewBag.SearchDate" class="form-control" />
        </div>
        <div class="col-md-3">
            <select name="searchStatus" class="form-select">
                <option value="">All Follow-Up Statuses</option>
                @foreach (FollowUpStatus st in Enum.GetValues(typeof(FollowUpStatus)))
                {
                    <option value="@st" selected="@(ViewBag.SearchStatus?.ToString() == st.ToString())">@st</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="searchAssignedUser" class="form-select">
                <option value="">All Users</option>
                @foreach (var u in usersList)
                {
                    <option value="@u.Id" selected="@(ViewBag.SearchAssignedUser == u.Id)">@u.FullName</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex">
            <button type="submit" class="btn btn-primary me-2 flex-grow-1"><i class="bi bi-search"></i> Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i> Reset</a>
        </div>
    </form>
</div>

<div class="table-responsive shadow-sm rounded-4">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Date & Time</th>
                <th>Type</th>
                <th>Related Entity</th>
                <th>Remarks / Notes</th>
                <th>Assigned To</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center py-4 text-muted">No follow-ups scheduled.</td>
                </tr>
            }
            else
            {
                @foreach (var f in Model)
                {
                    var isOverdue = f.Status == FollowUpStatus.Planned && f.FollowUpDate.Date < DateTime.UtcNow.Date;
                    <tr class="@(isOverdue ? "table-danger" : "")">
                        <td class="fw-bold">
                            @f.FollowUpDate.ToString("dd MMM yyyy")
                            @if (isOverdue)
                            {
                                <span class="badge bg-danger ms-1">OVERDUE</span>
                            }
                        </td>
                        <td><span class="badge bg-info text-dark">@f.FollowUpType</span></td>
                        <td>
                            @if (f.Customer != null)
                            {
                                <span class="fw-bold"><i class="bi bi-building"></i> @f.Customer.CustomerName</span>
                            }
                            else if (f.Lead != null)
                            {
                                <span class="fw-bold"><i class="bi bi-person"></i> Lead: @f.Lead.LeadName</span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td>@f.Remarks</td>
                        <td>@(f.AssignedUser?.FullName ?? "Unassigned")</td>
                        <td>
                            @switch (f.Status)
                            {
                                case FollowUpStatus.Planned: <span class="badge bg-warning text-dark">Planned</span> break;
                                case FollowUpStatus.Completed: <span class="badge bg-success">Completed</span> break;
                                case FollowUpStatus.Missed: <span class="badge bg-danger">Missed</span> break;
                                case FollowUpStatus.Cancelled: <span class="badge bg-secondary">Cancelled</span> break;
                            }
                        </td>
                        <td class="text-end">
                            @if (f.Status == FollowUpStatus.Planned)
                            {
                                <form asp-action="Complete" asp-route-id="@f.FollowUpId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success me-1" title="Mark Completed"><i class="bi bi-check-lg"></i> Complete</button>
                                </form>
                            }
                            <form asp-action="Delete" asp-route-id="@f.FollowUpId" method="post" class="d-inline" onsubmit="return confirm('Delete this follow-up record?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
