@model IEnumerable<AcxiomCRM.Domain.Entities.Activity>
@{
    ViewData["Title"] = "Activity Management";
    var usersList = ViewBag.UsersList as List<AcxiomCRM.Services.Interfaces.UserDto> ?? new List<AcxiomCRM.Services.Interfaces.UserDto>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-journal-text text-primary me-2"></i>Activity Management</h2>
        <p class="text-muted mb-0">Track and log customer interactions across Calls, Meetings, Emails and Tasks</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Log Activity
    </a>
</div>

<!-- Search & Filter Bar -->
<div class="card card-body bg-light border-0 mb-4 shadow-sm">
    <form method="get" asp-action="Index" class="row g-3">
        <div class="col-md-3">
            <select name="searchType" class="form-select">
                <option value="">All Activity Types</option>
                @foreach (ActivityType type in Enum.GetValues(typeof(ActivityType)))
                {
                    <option value="@type" selected="@(ViewBag.SearchType?.ToString() == type.ToString())">@type</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <input type="date" name="searchDate" value="@ViewBag.SearchDate" class="form-control" />
        </div>
        <div class="col-md-3">
            <select name="searchAssignedUser" class="form-select">
                <option value="">All Users</option>
                @foreach (var u in usersList)
                {
                    <option value="@u.Id" selected="@(ViewBag.SearchAssignedUser == u.Id)">@u.FullName</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex">
            <button type="submit" class="btn btn-primary me-2 flex-grow-1"><i class="bi bi-search"></i> Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i> Reset</a>
        </div>
    </form>
</div>

<div class="table-responsive shadow-sm rounded-4">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Type</th>
                <th>Subject</th>
                <th>Description</th>
                <th>Date</th>
                <th>Related Customer / Lead</th>
                <th>Assigned User</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center py-4 text-muted">No activities logged.</td>
                </tr>
            }
            else
            {
                @foreach (var a in Model)
                {
                    <tr>
                        <td>
                            @switch (a.ActivityType)
                            {
                                case ActivityType.Call: <span class="badge bg-primary"><i class="bi bi-telephone"></i> Call</span> break;
                                case ActivityType.Meeting: <span class="badge bg-success"><i class="bi bi-people"></i> Meeting</span> break;
                                case ActivityType.Email: <span class="badge bg-warning text-dark"><i class="bi bi-envelope"></i> Email</span> break;
                                case ActivityType.Task: <span class="badge bg-info text-dark"><i class="bi bi-check-square"></i> Task</span> break;
                            }
                        </td>
                        <td class="fw-bold">@a.Subject</td>
                        <td>@a.Description</td>
                        <td>@a.ActivityDate.ToString("dd MMM yyyy HH:mm")</td>
                        <td>
                            @if (a.Customer != null)
                            {
                                <span class="fw-bold"><i class="bi bi-building"></i> @a.Customer.CustomerName</span>
                            }
                            else if (a.Lead != null)
                            {
                                <span class="fw-bold"><i class="bi bi-person"></i> @a.Lead.LeadName</span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td>@(a.AssignedUser?.FullName ?? "Unassigned")</td>
                        <td><span class="badge bg-secondary">@a.Status</span></td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
