@model AcxiomCRM.Web.Models.ActivityViewModel
@{
    ViewData["Title"] = "Log Activity";
    var customersList = ViewBag.CustomersList as List<AcxiomCRM.Domain.Entities.Customer> ?? new List<AcxiomCRM.Domain.Entities.Customer>();
    var leadsList = ViewBag.LeadsList as List<AcxiomCRM.Domain.Entities.Lead> ?? new List<AcxiomCRM.Domain.Entities.Lead>();
    var usersList = ViewBag.UsersList as List<AcxiomCRM.Services.Interfaces.UserDto> ?? new List<AcxiomCRM.Services.Interfaces.UserDto>();
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h3 class="fw-bold mb-0"><i class="bi bi-journal-plus text-primary me-2"></i>Log CRM Activity</h3>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ActivityType" class="form-label fw-bold"></label>
                            <select asp-for="ActivityType" class="form-select" asp-items="Html.GetEnumSelectList<AcxiomCRM.Domain.Entities.ActivityType>()">
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Subject" class="form-label fw-bold"></label>
                            <input asp-for="Subject" class="form-control" placeholder="Activity Subject..." />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-bold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Details of interaction..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label fw-bold">Customer (Optional)</label>
                            <select asp-for="CustomerId" class="form-select">
                                <option value="">Select Customer...</option>
                                @foreach (var c in customersList)
                                {
                                    <option value="@c.CustomerId">@c.CustomerName</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LeadId" class="form-label fw-bold">Lead (Optional)</label>
                            <select asp-for="LeadId" class="form-select">
                                <option value="">Select Lead...</option>
                                @foreach (var l in leadsList)
                                {
                                    <option value="@l.LeadId">@l.LeadName</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ActivityDate" class="form-label fw-bold">Activity Date</label>
                            <input asp-for="ActivityDate" class="form-control" type="datetime-local" value="@Model.ActivityDate.ToString("yyyy-MM-ddTHH:mm")" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label fw-bold">Assigned User</label>
                            <select asp-for="AssignedTo" class="form-select">
                                @foreach (var u in usersList)
                                {
                                    <option value="@u.Id">@u.FullName (@u.Role)</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mt-4 text-end">
                        <a asp-action="Index" class="btn btn-outline-secondary me-2">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">Log Activity</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
