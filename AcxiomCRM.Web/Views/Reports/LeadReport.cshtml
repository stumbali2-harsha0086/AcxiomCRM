@model IEnumerable<AcxiomCRM.Domain.Entities.Lead>
@{
    ViewData["Title"] = "Lead Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-person-lines-fill text-info me-2"></i>2. Lead Report</h2>
        <p class="text-muted mb-0">Lead acquisition sources, status breakdown and conversion status</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Reports Hub</a>
</div>

<div class="table-responsive shadow-sm rounded-4">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Lead Code</th>
                <th>Lead Name</th>
                <th>Company</th>
                <th>Source</th>
                <th>Status</th>
                <th>Expected Value</th>
                <th>Assigned Executive</th>
                <th>Created Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in Model)
            {
                <tr>
                    <td class="fw-bold text-info">@l.LeadCode</td>
                    <td class="fw-bold">@l.LeadName</td>
                    <td>@(string.IsNullOrEmpty(l.CompanyName) ? "-" : l.CompanyName)</td>
                    <td><span class="badge bg-light text-dark border">@l.Source</span></td>
                    <td><span class="badge bg-secondary">@l.Status</span></td>
                    <td class="fw-bold">₹@l.ExpectedValue.ToString("N0")</td>
                    <td>@(l.AssignedUser?.FullName ?? "Unassigned")</td>
                    <td>@l.CreatedDate.ToString("dd MMM yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
