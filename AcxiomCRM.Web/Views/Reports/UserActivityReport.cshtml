@model IEnumerable<AcxiomCRM.Services.Interfaces.UserActivityReportItem>
@{
    ViewData["Title"] = "User Activity Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-person-workspace text-danger me-2"></i>7. User Activity Report</h2>
        <p class="text-muted mb-0">Operational performance, record creation and activity counts by user</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Reports Hub</a>
</div>

<div class="table-responsive shadow-sm rounded-4">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>User Name</th>
                <th>Role</th>
                <th>Customers Created</th>
                <th>Leads Assigned</th>
                <th>Opportunities Assigned</th>
                <th>Follow-Ups Scheduled</th>
                <th>Activities Logged</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td class="fw-bold text-dark">@u.UserName</td>
                    <td><span class="badge bg-primary">@u.Role</span></td>
                    <td class="fw-bold">@u.CustomersCreated</td>
                    <td class="fw-bold">@u.LeadsAssigned</td>
                    <td class="fw-bold">@u.OpportunitiesAssigned</td>
                    <td class="fw-bold">@u.FollowUpsCount</td>
                    <td class="fw-bold text-success">@u.ActivitiesCount</td>
                </tr>
            }
        </tbody>
    </table>
</div>
