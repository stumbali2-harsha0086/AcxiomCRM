@model IEnumerable<AcxiomCRM.Services.Interfaces.PipelineReportItem>
@{
    ViewData["Title"] = "Pipeline Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-funnel text-primary me-2"></i>5. Pipeline Report</h2>
        <p class="text-muted mb-0">Stage-wise and Owner-wise sales pipeline revenue aggregation</p>
    </div>
    <div>
        <a asp-action="PipelineReport" asp-route-groupBy="stage" class="btn btn-outline-primary me-1 @(ViewBag.GroupBy == "stage" ? "active" : "")">Group by Stage</a>
        <a asp-action="PipelineReport" asp-route-groupBy="owner" class="btn btn-outline-primary me-2 @(ViewBag.GroupBy == "owner" ? "active" : "")">Group by Owner</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Reports Hub</a>
    </div>
</div>

<div class="table-responsive shadow-sm rounded-4">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>@(ViewBag.GroupBy == "owner" ? "Owner / Executive" : "Pipeline Stage")</th>
                <th>Opportunity Count</th>
                <th>Total Value (₹)</th>
                <th>Weighted Value (₹)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold fs-5 text-primary">@item.StageOrOwner</td>
                    <td class="fw-bold">@item.OpportunityCount</td>
                    <td class="fw-bold text-dark">₹@item.TotalAmount.ToString("N0")</td>
                    <td class="fw-bold text-success fs-5">₹@item.WeightedAmount.ToString("N0")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
