@model AcxiomCRM.Services.Interfaces.ConversionReportDto
@{
    ViewData["Title"] = "Sales Conversion Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-arrow-repeat text-purple me-2"></i>6. Sales & Conversion Report</h2>
        <p class="text-muted mb-0">Lead-to-Customer conversion rates and Opportunity win metrics</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Reports Hub</a>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h4 class="fw-bold text-primary mb-3"><i class="bi bi-person-check me-2"></i>Lead Conversion Metrics</h4>
            <div class="row g-3">
                <div class="col-6">
                    <span class="text-muted small">Total Leads Captured</span>
                    <h3 class="fw-bold">@Model.TotalLeads</h3>
                </div>
                <div class="col-6">
                    <span class="text-muted small">Leads Converted</span>
                    <h3 class="fw-bold text-success">@Model.ConvertedLeads</h3>
                </div>
                <div class="col-6">
                    <span class="text-muted small">Unconverted Leads</span>
                    <h3 class="fw-bold text-warning">@Model.UnconvertedLeads</h3>
                </div>
                <div class="col-6">
                    <span class="text-muted small">Conversion Rate</span>
                    <h3 class="fw-bold text-primary">@Model.ConversionRate%</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h4 class="fw-bold text-success mb-3"><i class="bi bi-trophy me-2"></i>Opportunity Outcome Metrics</h4>
            <div class="row g-3">
                <div class="col-6">
                    <span class="text-muted small">Total Opportunities</span>
                    <h3 class="fw-bold">@Model.TotalOpportunities</h3>
                </div>
                <div class="col-6">
                    <span class="text-muted small">Won Deals</span>
                    <h3 class="fw-bold text-success">@Model.WonOpportunities</h3>
                </div>
                <div class="col-6">
                    <span class="text-muted small">Total Won Revenue</span>
                    <h3 class="fw-bold text-success">₹@Model.WonValue.ToString("N0")</h3>
                </div>
                <div class="col-6">
                    <span class="text-muted small">Win Rate</span>
                    <h3 class="fw-bold text-success">@Model.WinRate%</h3>
                </div>
            </div>
        </div>
    </div>
</div>
