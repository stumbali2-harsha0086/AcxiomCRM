@model IEnumerable<AcxiomCRM.Domain.Entities.Opportunity>
@{
    ViewData["Title"] = "Opportunity Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-graph-up text-success me-2"></i>4. Opportunity Report</h2>
        <p class="text-muted mb-0">Deal stages, amounts, probabilities and expected close dates</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Reports Hub</a>
</div>

<div class="table-responsive shadow-sm rounded-4">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Opportunity Name</th>
                <th>Customer</th>
                <th>Stage</th>
                <th>Amount (₹)</th>
                <th>Probability</th>
                <th>Weighted Value (₹)</th>
                <th>Expected Close Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td class="fw-bold">@o.OpportunityName</td>
                    <td>@(o.Customer?.CustomerName ?? "-")</td>
                    <td><span class="badge bg-primary">@o.Stage</span></td>
                    <td class="fw-bold">₹@o.Amount.ToString("N0")</td>
                    <td>@o.Probability%</td>
                    <td class="fw-bold text-success">₹@o.WeightedValue.ToString("N0")</td>
                    <td>@o.ExpectedCloseDate.ToString("dd MMM yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
