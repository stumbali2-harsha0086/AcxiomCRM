@model IEnumerable<AcxiomCRM.Domain.Entities.FollowUp>
@{
    ViewData["Title"] = "Follow-Up Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-calendar-event text-warning me-2"></i>3. Follow-Up Report</h2>
        <p class="text-muted mb-0">Planned, completed, missed and overdue activity tracking</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Reports Hub</a>
</div>

<div class="table-responsive shadow-sm rounded-4">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Entity</th>
                <th>Remarks</th>
                <th>Assigned User</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var f in Model)
            {
                <tr>
                    <td class="fw-bold">@f.FollowUpDate.ToString("dd MMM yyyy")</td>
                    <td><span class="badge bg-info text-dark">@f.FollowUpType</span></td>
                    <td>@(f.Customer?.CustomerName ?? f.Lead?.LeadName ?? "-")</td>
                    <td>@f.Remarks</td>
                    <td>@(f.AssignedUser?.FullName ?? "Unassigned")</td>
                    <td><span class="badge bg-secondary">@f.Status</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>
