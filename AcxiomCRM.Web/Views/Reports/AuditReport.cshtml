@model IEnumerable<AcxiomCRM.Domain.Entities.AuditLog>
@{
    ViewData["Title"] = "Audit Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-shield-check text-dark me-2"></i>8. Audit Report</h2>
        <p class="text-muted mb-0">Security, authentication and compliance audit events</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Reports Hub</a>
</div>

<div class="table-responsive shadow-sm rounded-4">
    <table class="table table-hover align-middle mb-0 font-monospace small">
        <thead class="table-dark">
            <tr>
                <th>Timestamp</th>
                <th>User</th>
                <th>Action</th>
                <th>Entity</th>
                <th>Record ID</th>
                <th>IP Address</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td class="fw-bold">@(a.User?.FullName ?? a.UserId)</td>
                    <td><span class="badge bg-warning text-dark">@a.Action</span></td>
                    <td class="fw-bold">@a.EntityName</td>
                    <td>@a.RecordId</td>
                    <td>@a.IpAddress</td>
                </tr>
            }
        </tbody>
    </table>
</div>
