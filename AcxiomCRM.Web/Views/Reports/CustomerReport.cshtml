@model IEnumerable<AcxiomCRM.Domain.Entities.Customer>
@{
    ViewData["Title"] = "Customer Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-people text-primary me-2"></i>1. Customer Report</h2>
        <p class="text-muted mb-0">Customer master details, status, owner assignment and creation date</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Reports Hub</a>
</div>

<div class="table-responsive shadow-sm rounded-4">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Code</th>
                <th>Customer Name</th>
                <th>Company</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Status</th>
                <th>Owner / Created By</th>
                <th>Created Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td class="fw-bold text-primary">@c.CustomerCode</td>
                    <td class="fw-bold">@c.CustomerName</td>
                    <td>@(string.IsNullOrEmpty(c.CompanyName) ? "-" : c.CompanyName)</td>
                    <td>@c.Email</td>
                    <td>@c.Phone</td>
                    <td><span class="badge bg-success">@c.Status</span></td>
                    <td>@(c.Owner?.FullName ?? "System")</td>
                    <td>@c.CreatedDate.ToString("dd MMM yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
