@model AcxiomCRM.Web.Models.OpportunityViewModel
@{
    ViewData["Title"] = "Edit Opportunity";
    var customersList = ViewBag.CustomersList as List<AcxiomCRM.Domain.Entities.Customer> ?? new List<AcxiomCRM.Domain.Entities.Customer>();
    var usersList = ViewBag.UsersList as List<AcxiomCRM.Services.Interfaces.UserDto> ?? new List<AcxiomCRM.Services.Interfaces.UserDto>();
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h3 class="fw-bold mb-0"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Opportunity</h3>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.OpportunityId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="OpportunityId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="OpportunityName" class="form-label fw-bold"></label>
                            <input asp-for="OpportunityName" class="form-control" />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label fw-bold">Customer</label>
                            <select asp-for="CustomerId" class="form-select">
                                <option value="">Select Customer...</option>
                                @foreach (var c in customersList)
                                {
                                    <option value="@c.CustomerId">@c.CustomerName</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Amount" class="form-label fw-bold">Opportunity Amount (₹)</label>
                            <input asp-for="Amount" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Probability" class="form-label fw-bold">Win Probability (%)</label>
                            <input asp-for="Probability" class="form-control" type="number" min="0" max="100" />
                            <span asp-validation-for="Probability" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Stage" class="form-label fw-bold">Pipeline Stage</label>
                            <select asp-for="Stage" class="form-select" asp-items="Html.GetEnumSelectList<AcxiomCRM.Domain.Entities.OpportunityStage>()">
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ExpectedCloseDate" class="form-label fw-bold">Expected Close Date</label>
                            <input asp-for="ExpectedCloseDate" class="form-control" type="date" value="@Model.ExpectedCloseDate.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label fw-bold">Assigned Sales Executive</label>
                            <select asp-for="AssignedTo" class="form-select">
                                @foreach (var u in usersList)
                                {
                                    <option value="@u.Id">@u.FullName (@u.Role)</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mt-4 text-end">
                        <a asp-action="Index" class="btn btn-outline-secondary me-2">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">Update Opportunity</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
