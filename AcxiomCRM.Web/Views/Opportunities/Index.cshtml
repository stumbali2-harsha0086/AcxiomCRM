@model IEnumerable<AcxiomCRM.Domain.Entities.Opportunity>
@{
    ViewData["Title"] = "Opportunity Management";
    var customersList = ViewBag.CustomersList as List<AcxiomCRM.Domain.Entities.Customer> ?? new List<AcxiomCRM.Domain.Entities.Customer>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-graph-up-arrow text-primary me-2"></i>Opportunities</h2>
        <p class="text-muted mb-0">Sales pipeline, deal tracking, probability and weighted revenue forecast</p>
    </div>
    <div>
        <a asp-action="Pipeline" class="btn btn-outline-primary shadow-sm me-2">
            <i class="bi bi-kanban me-1"></i> Pipeline View
        </a>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> New Opportunity
        </a>
    </div>
</div>

<!-- Search & Filter Bar -->
<div class="card card-body bg-light border-0 mb-4 shadow-sm">
    <form method="get" asp-action="Index" class="row g-3">
        <div class="col-md-3">
            <input type="text" name="searchName" value="@ViewBag.SearchName" class="form-control" placeholder="Search Opportunity Name..." />
        </div>
        <div class="col-md-3">
            <select name="searchCustomerId" class="form-select">
                <option value="">All Customers</option>
                @foreach (var c in customersList)
                {
                    <option value="@c.CustomerId" selected="@(ViewBag.SearchCustomerId == c.CustomerId)">@c.CustomerName</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="searchStage" class="form-select">
                <option value="">All Pipeline Stages</option>
                @foreach (OpportunityStage st in Enum.GetValues(typeof(OpportunityStage)))
                {
                    <option value="@st" selected="@(ViewBag.SearchStage?.ToString() == st.ToString())">@st</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex">
            <button type="submit" class="btn btn-primary me-2 flex-grow-1"><i class="bi bi-search"></i> Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i> Reset</a>
        </div>
    </form>
</div>

<div class="table-responsive shadow-sm rounded-4">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Opportunity Name</th>
                <th>Customer</th>
                <th>Amount (₹)</th>
                <th>Stage</th>
                <th>Probability</th>
                <th>Weighted Value (₹)</th>
                <th>Exp. Close Date</th>
                <th>Assigned To</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="9" class="text-center py-4 text-muted">No opportunities found.</td>
                </tr>
            }
            else
            {
                @foreach (var o in Model)
                {
                    <tr>
                        <td class="fw-bold text-dark">@o.OpportunityName</td>
                        <td>@(o.Customer?.CustomerName ?? "-")</td>
                        <td class="fw-bold">₹@o.Amount.ToString("N0")</td>
                        <td>
                            @switch (o.Stage)
                            {
                                case OpportunityStage.Qualification: <span class="badge bg-secondary">Qualification</span> break;
                                case OpportunityStage.Proposal: <span class="badge bg-info">Proposal</span> break;
                                case OpportunityStage.Negotiation: <span class="badge bg-warning text-dark">Negotiation</span> break;
                                case OpportunityStage.Won: <span class="badge bg-success">Won</span> break;
                                case OpportunityStage.Lost: <span class="badge bg-danger">Lost</span> break;
                            }
                        </td>
                        <td>
                            <div class="progress" style="height: 16px; width: 80px;">
                                <div class="progress-bar bg-primary" role="progressbar" style="width: @o.Probability%;" aria-valuenow="@o.Probability" aria-valuemin="0" aria-valuemax="100">@o.Probability%</div>
                            </div>
                        </td>
                        <td class="fw-bold text-success">₹@o.WeightedValue.ToString("N0")</td>
                        <td>@o.ExpectedCloseDate.ToString("dd MMM yyyy")</td>
                        <td>@(o.AssignedUser?.FullName ?? "Unassigned")</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@o.OpportunityId" class="btn btn-sm btn-outline-primary me-1" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@o.OpportunityId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this opportunity?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
