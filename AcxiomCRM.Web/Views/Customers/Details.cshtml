@model AcxiomCRM.Domain.Entities.Customer
@{
    ViewData["Title"] = "Customer Details - " + Model.CustomerName;
    var opportunities = ViewBag.Opportunities as List<AcxiomCRM.Domain.Entities.Opportunity> ?? new List<AcxiomCRM.Domain.Entities.Opportunity>();
    var activities = ViewBag.Activities as List<AcxiomCRM.Domain.Entities.Activity> ?? new List<AcxiomCRM.Domain.Entities.Activity>();
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h2 class="fw-bold mb-1">@Model.CustomerName <span class="badge bg-primary fs-6">@Model.CustomerCode</span></h2>
        <p class="text-muted mb-0">Created on @Model.CreatedDate.ToString("dd MMMM yyyy") by <strong>@(Model.Owner?.FullName ?? "System")</strong></p>
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-outline-primary me-2"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back to List</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-0 pt-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-info-circle text-primary me-2"></i>Contact Profile</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Company</span>
                        <span class="fw-bold">@(string.IsNullOrEmpty(Model.CompanyName) ? "-" : Model.CompanyName)</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Email</span>
                        <span class="fw-bold"><a href="mailto:@Model.Email">@Model.Email</a></span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Phone</span>
                        <span class="fw-bold">@Model.Phone</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">City / State</span>
                        <span class="fw-bold">@Model.City, @Model.State</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Status</span>
                        <span class="badge bg-success">@Model.Status</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-0 pt-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-graph-up text-success me-2"></i>Associated Opportunities</h5>
                <a asp-controller="Opportunities" asp-action="Create" class="btn btn-sm btn-outline-success"><i class="bi bi-plus"></i> New Deal</a>
            </div>
            <div class="card-body">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Amount</th>
                            <th>Stage</th>
                            <th>Exp. Close</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!opportunities.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-3">No active opportunities found for this customer.</td></tr>
                        }
                        else
                        {
                            foreach (var o in opportunities)
                            {
                                <tr>
                                    <td class="fw-bold">@o.OpportunityName</td>
                                    <td>₹@o.Amount.ToString("N0")</td>
                                    <td><span class="badge bg-info">@o.Stage</span></td>
                                    <td>@o.ExpectedCloseDate.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-journal-text text-warning me-2"></i>Recent Activities & History</h5>
                <a asp-controller="Activities" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-sm btn-outline-warning"><i class="bi bi-plus"></i> Log Activity</a>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    @if (!activities.Any())
                    {
                        <li class="list-group-item text-center text-muted py-3">No activity logs recorded.</li>
                    }
                    else
                    {
                        foreach (var a in activities)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="fw-bold"><span class="badge bg-secondary me-2">@a.ActivityType</span> @a.Subject</div>
                                    <small class="text-muted">@a.Description</small>
                                </div>
                                <span class="badge bg-light text-dark border">@a.ActivityDate.ToString("dd MMM yyyy")</span>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
